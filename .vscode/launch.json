{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAP-Link Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "./build/Debug/FOC.elf", // ✅ 重要：请替换为你的 .elf 文件路径
            "servertype": "openocd",                   // 调试服务器类型
            "configFiles": [                           // ⭐ 这里就是移植的关键
                "interface/cmsis-dap.cfg",             // 对应你的 source [find interface/cmsis-dap.cfg]
                "target/stm32f4x.cfg"                  // 对应你的 source [find target/stm32f4x.cfg]
            ],
            // ⭐ 以下是翻译你的 transport select swd, adapter speed 等命令
            "openOCDLaunchCommands": [                
                "transport select swd",                // 对应 transport select swd
                "adapter speed 4000",                  // 对应 adapter speed 4000
                "reset_config none"                    // 对应 reset_config none
            ],
            "svdFile": "./.vscode/STM32F407xx.svd"     // 强烈建议添加，用于查看外设寄存器
            // 如果想在 main 函数入口自动停下，可以添加下面这行
            // "runToMain": true
        }
    ]
}